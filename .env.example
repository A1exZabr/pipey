# Pipey CRM — Environment Variables
# Copy to .env and fill in real values: cp .env.example .env

# =============================================================================
# DEPLOYMENT
# =============================================================================

# Server IP or domain (no trailing slash, used for CORS + frontend API URL)
HOST_URL=http://localhost

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_USER=pipey
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pipey_db
DATABASE_URL=postgresql://pipey:change-me@localhost:5432/pipey_db

# Redis
REDIS_URL=redis://localhost:6379

# =============================================================================
# BACKEND
# =============================================================================
PORT=3001
NODE_ENV=production

# JWT & Auth
JWT_SECRET=change-me-to-a-random-string-min-16-chars
JWT_EXPIRES_IN=7d
MAGIC_LINK_SECRET=change-me-to-another-random-string
MAGIC_LINK_EXPIRES_IN=15m

# Encryption (32-char hex string for channel credentials)
# Generate: openssl rand -hex 16
ENCRYPTION_KEY=change-me-to-a-random-32-char-hex-string

# =============================================================================
# FRONTEND
# =============================================================================
NEXT_PUBLIC_API_URL=http://localhost:3101

# =============================================================================
# FILE STORAGE (MinIO S3-compatible)
# =============================================================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=pipey
MINIO_SECRET_KEY=change-me
MINIO_USE_SSL=false

# =============================================================================
# CHANNELS
# =============================================================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# MAX Bot
MAX_BOT_TOKEN=
MAX_API_URL=https://api.max.ru

# Avito
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
AVITO_API_URL=https://api.avito.ru

# =============================================================================
# AI
# =============================================================================
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-3-haiku
OPENROUTER_FALLBACK_MODEL=openai/gpt-3.5-turbo

# =============================================================================
# ERROR TRACKING (GlitchTip — Sentry-compatible)
# =============================================================================
# After setting up GlitchTip, paste DSN here:
# SENTRY_DSN=https://xxx@your-glitchtip:8000/1
# GLITCHTIP_SECRET_KEY=change-me

# =============================================================================
# PUSH NOTIFICATIONS (optional)
# =============================================================================
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
