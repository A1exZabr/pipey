# Required
DATABASE_URL=postgresql://pipey:pipey_dev_password@localhost:5432/pipey_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-super-secret-jwt-key-min-16-chars
ENCRYPTION_KEY=your-super-secret-32-char-key-here

# Optional
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001

# Integrations
OPENROUTER_API_KEY=

# === Sentry ===
SENTRY_DSN=                          # Sentry DSN from self-hosted instance (leave empty to disable)
SENTRY_ENVIRONMENT=development       # development | staging | production
SENTRY_RELEASE=0.7.0                 # Release version tag
SENTRY_AUTH_TOKEN=                   # For source map uploads (optional)

# Push notifications (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Rate limits (optional, defaults shown)
RATE_LIMIT_IP=100
RATE_LIMIT_ORG=300
RATE_LIMIT_AUTH=5

# === Monitoring (Prometheus + Grafana) ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=pipey_grafana    # Change in production!
GRAFANA_ROOT_URL=http://localhost:3100

# === TLS / Domain ===
DOMAIN=your-domain.com                  # Your production domain
CERTBOT_EMAIL=admin@your-domain.com     # Email for Let's Encrypt notifications
